# Copy this file to .env and fill in real values for local development.
# .env is only loaded if python-dotenv is installed (see requirements.txt).
# Never commit your real .env file to version control.

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 to make the app refuse to start if SECRET_KEY is missing.
# Strongly recommended for any real deployment.
REQUIRE_SECRET_KEY=0

# Set to 1 once the site is served over HTTPS (adds Secure cookies + HSTS header).
SECURE_COOKIES=0

# Optional: shares rate-limit / login-lockout state across multiple worker
# processes (Gunicorn -w N). Without this, rate limiting only works correctly
# with a single worker.
REDIS_URL=
